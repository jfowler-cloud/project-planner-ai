# Deployment tier (testing/optimized/premium)
# testing: Haiku 3.0 (cheapest)
# optimized: Sonnet 4.5 + Haiku 4.5
# premium: Opus 4.5 (all)
DEPLOYMENT_TIER=testing

# AI Provider (bedrock or anthropic)
AI_PROVIDER=bedrock

# Anthropic API (if using anthropic provider)
ANTHROPIC_API_KEY=

# AWS (if using bedrock provider)
AWS_REGION=us-east-1
AWS_PROFILE=

# Other settings
GITHUB_TOKEN=
REDIS_URL=redis://localhost:6379
DYNAMODB_TABLE=project-planner-projects

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
