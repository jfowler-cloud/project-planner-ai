AWS_REGION=us-east-1
AWS_PROFILE=admin
GITHUB_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000

# AI model (Bedrock model ID)
# Testing/default: anthropic.claude-haiku-4-5-20251001-v1:0 (fast, cheap)
# Optimized:       anthropic.claude-sonnet-4-5-20250929-v1:0
# Premium:         anthropic.claude-opus-4-5-20251101-v1:0
BEDROCK_MODEL_ID=

# Deployment tier controls model selection in ClaudeClient (testing/optimized/premium)
DEPLOYMENT_TIER=testing
