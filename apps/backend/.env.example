AWS_REGION=us-east-1
AWS_PROFILE=admin
GITHUB_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000

# AI model (Bedrock model ID)
# Testing/default: claude-haiku-4-20250514 (fast, cheap)
# Optimized:       claude-sonnet-4-20250514
# Premium:         claude-opus-4-20250514
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-20250514-v1:0

# Deployment tier controls model selection in ClaudeClient (testing/optimized/premium)
DEPLOYMENT_TIER=testing
